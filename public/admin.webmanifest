{
  "id": "/admin",
  "name": "keithvassallo.com admin",
  "short_name": "Blog admin",
  "description": "Write, generate, revise and publish posts for keithvassallo.com",
  "lang": "en-GB",
  "dir": "ltr",
  "start_url": "/admin",
  "scope": "/admin",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0b0d12",
  "theme_color": "#0b0d12",
  "categories": ["productivity"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/admin-icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/admin-icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/admin-icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/admin-icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/admin-icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/admin-icons/badge-96.png", "sizes": "96x96", "type": "image/png", "purpose": "monochrome" }
  ],
  "shortcuts": [
    {
      "name": "New idea",
      "short_name": "Idea",
      "description": "Add an idea to the queue",
      "url": "/admin#/ideas",
      "icons": [{ "src": "/admin-icons/shortcut-idea.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Posts",
      "description": "Every post, its drafts and what needs you",
      "url": "/admin#/",
      "icons": [{ "src": "/admin-icons/shortcut-posts.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Weekly run",
      "short_name": "Weekly",
      "description": "The Saturday draft, and turning it on or off",
      "url": "/admin#/weekly",
      "icons": [{ "src": "/admin-icons/shortcut-weekly.png", "sizes": "96x96", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "/admin",
    "method": "GET",
    "params": { "title": "share-title", "text": "share-text", "url": "share-url" }
  },
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] }
}
