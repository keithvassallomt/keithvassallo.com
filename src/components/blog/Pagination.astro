---
import type { Page } from 'astro';
import { Icon } from 'astro-icon/components';

interface Props {
  page: Page<unknown>;
}

const { page } = Astro.props;
---

{
  page.lastPage > 1 && (
    <nav class="pagination" aria-label="Pagination">
      {page.url.prev ? (
        <a href={page.url.prev} rel="prev" class="pagination-link">
          <Icon name="lucide:arrow-left" aria-hidden="true" />
          Newer posts
        </a>
      ) : (
        <span />
      )}
      <span class="pagination-status">
        Page {page.currentPage} of {page.lastPage}
      </span>
      {page.url.next ? (
        <a href={page.url.next} rel="next" class="pagination-link">
          Older posts
          <Icon name="lucide:arrow-right" aria-hidden="true" />
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}

<style>
  .pagination {
    max-width: 1180px;
    margin: 48px auto 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-md);
  }

  .pagination-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    padding: 0 22px;
    font-weight: 700;
    color: var(--blog-text);
    border: 1px solid var(--blog-border);
    border-radius: 999px;
  }

  .pagination-link:hover {
    color: var(--blog-text);
    background: var(--blog-surface);
  }

  .pagination-link[rel='next'] {
    justify-self: end;
  }

  .pagination-link[rel='prev'] {
    justify-self: start;
  }

  .pagination-status {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--blog-muted);
  }

  @media (max-width: 600px) {
    .pagination {
      grid-template-columns: 1fr 1fr;
    }

    .pagination-status {
      grid-column: 1 / -1;
      grid-row: 1;
      text-align: center;
    }

    .pagination-link {
      padding: 0 16px;
    }
  }
</style>
