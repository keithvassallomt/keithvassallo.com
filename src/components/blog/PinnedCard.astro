---
import { Image } from 'astro:assets';
import CategoryChip from './CategoryChip.astro';
import FormattedDate from './FormattedDate.astro';
import { postUrl, readingTime, type Category, type Post } from '../../lib/blog';

// The pinned post, above the listing's grid on its first page. Set from the blog admin; the
// listing removes it once `until` passes.
interface Props {
  post: Post;
  category: Category;
}

const { post, category } = Astro.props;
const { title, description, cover, pubDate } = post.data;
---

<div class="pin-wrap" data-pin-card>
  <article class="pinned">
    {
      cover && (
        <div class="pinned-media">
          <Image src={cover} alt="" widths={[640, 960, 1280]} sizes="(min-width: 1180px) 560px, 100vw" loading="eager" class="pinned-image" />
        </div>
      )
    }
    <div class="pinned-body">
      <div class="pinned-flags">
        <span class="pinned-flag">Pinned</span>
        <CategoryChip category={category} />
      </div>
      <h2 class="pinned-title"><a href={postUrl(post)} class="pinned-link">{title}</a></h2>
      <p class="pinned-excerpt">{description}</p>
      <p class="pinned-meta">
        <FormattedDate date={pubDate} format="short" />
        <span aria-hidden="true">·</span>
        <span>{readingTime(post)} min read</span>
      </p>
    </div>
  </article>
</div>

<style>
  .pin-wrap {
    container-type: inline-size;
    max-width: 1180px;
    margin: 0 auto 24px;
  }

  .pinned {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--blog-surface);
    border: 1px solid color-mix(in srgb, var(--c-green) 40%, var(--blog-border));
    border-radius: 20px;
    overflow: hidden;
    transition: border-color var(--transition-fast);
  }

  .pinned:hover {
    border-color: var(--c-green);
  }

  .pinned:has(.pinned-link:focus-visible) {
    outline: 2px solid var(--c-green);
    outline-offset: 3px;
  }

  .pinned-link {
    color: inherit;
    text-decoration: none;
  }

  /* The title link covers the whole card */
  .pinned-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .pinned-link:focus-visible {
    outline: none;
  }

  .pinned-media {
    display: flex;
    background: var(--blog-raised);
  }

  .pinned-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 560;
    object-fit: cover;
  }

  .pinned-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
    padding: 24px 26px 28px;
  }

  .pinned-flags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .pinned-flag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-green);
  }

  .pinned-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2.1rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--blog-text);
  }

  .pinned-excerpt {
    margin: 0;
    font-size: 1.0625rem;
    color: var(--blog-secondary);
  }

  .pinned-meta {
    display: flex;
    gap: 8px;
    margin: 0;
    font-size: 0.9375rem;
    color: var(--blog-muted);
  }

  @container (min-width: 760px) {
    .pinned {
      flex-direction: row;
    }

    .pinned-media {
      flex: 0 0 48%;
    }

    .pinned-image {
      height: 100%;
      aspect-ratio: auto;
    }
  }
</style>
