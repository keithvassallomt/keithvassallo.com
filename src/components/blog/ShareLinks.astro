---
import { Icon } from 'astro-icon/components';
import type { SharePlatform } from '../../lib/share';

interface Props {
  /** Canonical URL of the post. */
  url: string;
  title: string;
  /** Suggested post text per network, from shareTexts() in src/lib/share.ts. */
  texts: Record<SharePlatform, string>;
}

const { url, title, texts } = Astro.props;
const encode = encodeURIComponent;

// Plain links work without JavaScript. X, Bluesky, Threads and Mastodon accept prefilled text in the link.
// LinkedIn and Facebook only take a URL, so the script copies their text to the clipboard.
const networks = [
  {
    name: 'LinkedIn',
    icon: 'simple-icons:linkedin',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encode(url)}`,
    copyText: texts.linkedin,
  },
  {
    name: 'Bluesky',
    icon: 'simple-icons:bluesky',
    href: `https://bsky.app/intent/compose?text=${encode(`${texts.bluesky}\n\n${url}`)}`,
  },
  {
    name: 'Threads',
    icon: 'simple-icons:threads',
    href: `https://www.threads.com/intent/post?text=${encode(texts.threads)}&url=${encode(url)}`,
  },
  {
    name: 'X',
    icon: 'simple-icons:x',
    href: `https://x.com/intent/post?text=${encode(texts.x)}&url=${encode(url)}`,
  },
  {
    name: 'Facebook',
    icon: 'simple-icons:facebook',
    href: `https://www.facebook.com/sharer/sharer.php?u=${encode(url)}`,
    copyText: texts.facebook,
  },
  {
    // Mastodon's own page asks for the visitor's server, and remembers it across every site that uses it
    name: 'Mastodon',
    icon: 'simple-icons:mastodon',
    href: `https://share.joinmastodon.org/#text=${encode(`${texts.mastodon}\n\n${url}`)}`,
  },
];
const displayUrl = url.replace(/^https:\/\//, '');
// For anywhere a post can't be prefilled: the long-form blurb, with the link under it
const blurb = `${texts.linkedin}\n\n${url}`;
---

<section class="share" aria-labelledby="share-heading">
  <h2 id="share-heading" class="share-heading">Share this post</h2>
  <div class="share-row">
    <!-- The buttons need JavaScript; the script reveals each one the browser supports -->
    <button type="button" class="share-button" data-copy-link={url} hidden>
      <Icon name="lucide:link" aria-hidden="true" />
      <span>Copy link</span>
    </button>
    <button type="button" class="share-button" data-copy-blurb={blurb} hidden>
      <Icon name="lucide:text-quote" aria-hidden="true" />
      <span>Copy blurb</span>
    </button>
    <button type="button" class="share-button" data-native-share={url} data-share-title={title} hidden>
      <Icon name="lucide:share-2" aria-hidden="true" />
      <span>Share</span>
    </button>
    {
      networks.map((network) => (
        <a
          class="share-button share-icon"
          href={network.href}
          target="_blank"
          rel="noopener noreferrer"
          data-copy-text={network.copyText}
          data-network={network.name}
        >
          <Icon name={network.icon} aria-hidden="true" />
          <span class="sr-only">Share on {network.name} (opens in a new tab)</span>
        </a>
      ))
    }
  </div>
  <p class="share-permalink">
    <span class="share-permalink-label">Permalink</span>
    <a href={url}>{displayUrl}</a>
  </p>
  <p class="share-status" role="status" aria-live="polite"></p>
</section>

<script>
  function initShareButtons() {
    const status = document.querySelector<HTMLElement>('.share-status');
    const announce = (message: string) => {
      if (status) status.textContent = message;
    };

    document.querySelectorAll<HTMLButtonElement>('[data-copy-link], [data-copy-blurb]').forEach((button) => {
      if (!navigator.clipboard || button.dataset.ready) return;
      button.dataset.ready = 'true';
      button.hidden = false;
      const { copyBlurb } = button.dataset;
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(copyBlurb ?? button.dataset.copyLink ?? location.href);
          announce(copyBlurb ? 'Blurb and link copied. Paste them wherever you’re sharing.' : 'Link copied to clipboard.');
        } catch {
          announce(`Could not copy the ${copyBlurb ? 'blurb' : 'link'}. Use the permalink below instead.`);
        }
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-native-share]').forEach((button) => {
      if (!navigator.share || button.dataset.ready) return;
      button.dataset.ready = 'true';
      button.hidden = false;
      button.addEventListener('click', () => {
        navigator.share({ title: button.dataset.shareTitle, url: button.dataset.nativeShare }).catch(() => {});
      });
    });

    // LinkedIn and Facebook can't prefill a post, so hand the suggested text over via the clipboard
    document.querySelectorAll<HTMLAnchorElement>('[data-copy-text]').forEach((link) => {
      if (!navigator.clipboard || link.dataset.ready) return;
      link.dataset.ready = 'true';
      link.addEventListener('click', () => {
        navigator.clipboard
          .writeText(link.dataset.copyText ?? '')
          .then(() => announce(`Suggested text copied. Paste it into your ${link.dataset.network} post.`))
          .catch(() => {});
      });
    });
  }

  document.addEventListener('astro:page-load', initShareButtons);
</script>

<style>
  .share {
    margin: 48px 0 32px;
    padding-top: 28px;
    border-top: 1px solid var(--blog-border);
  }

  .share-heading {
    margin: 0 0 14px;
    font-family: var(--font-reading);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blog-muted);
  }

  .share-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .share-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 44px;
    min-height: 44px;
    padding: 0 16px;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--blog-body);
    background: var(--blog-surface);
    border: 1px solid var(--blog-border);
    border-radius: 12px;
    cursor: pointer;
  }

  .share-button[hidden] {
    display: none;
  }

  .share-button:hover {
    color: var(--blog-text);
    border-color: #3b4453;
  }

  .share-icon {
    padding: 0;
  }

  .share-permalink {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin: 16px 0 0;
    font-size: 0.875rem;
    color: var(--blog-muted);
  }

  .share-permalink-label {
    font-weight: 700;
  }

  .share-permalink a {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--blog-secondary);
    word-break: break-all;
  }

  .share-status {
    min-height: 1.5em;
    margin: 8px 0 0;
    font-size: 0.875rem;
    color: var(--c-green);
  }
</style>
