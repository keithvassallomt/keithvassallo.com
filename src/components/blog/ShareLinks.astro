---
import { Icon } from 'astro-icon/components';
import type { SharePlatform } from '../../lib/share';

interface Props {
  /** Canonical URL of the post. */
  url: string;
  title: string;
  /** Suggested post text per network, from shareTexts() in src/lib/share.ts. */
  texts: Record<SharePlatform, string>;
}

const { url, title, texts } = Astro.props;
const encode = encodeURIComponent;

// Plain links work without JavaScript. X, Bluesky and Threads accept prefilled text in the link.
// LinkedIn and Facebook only take a URL, so the script copies their text to the clipboard.
const networks = [
  {
    name: 'LinkedIn',
    icon: 'simple-icons:linkedin',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encode(url)}`,
    copyText: texts.linkedin,
  },
  {
    name: 'Bluesky',
    icon: 'simple-icons:bluesky',
    href: `https://bsky.app/intent/compose?text=${encode(`${texts.bluesky}\n\n${url}`)}`,
  },
  {
    name: 'Threads',
    icon: 'simple-icons:threads',
    href: `https://www.threads.com/intent/post?text=${encode(texts.threads)}&url=${encode(url)}`,
  },
  {
    name: 'X',
    icon: 'simple-icons:x',
    href: `https://x.com/intent/post?text=${encode(texts.x)}&url=${encode(url)}`,
  },
  {
    name: 'Facebook',
    icon: 'simple-icons:facebook',
    href: `https://www.facebook.com/sharer/sharer.php?u=${encode(url)}`,
    copyText: texts.facebook,
  },
];
const displayUrl = url.replace(/^https:\/\//, '');
---

<section class="share" aria-labelledby="share-heading">
  <h2 id="share-heading" class="share-heading">Share this post</h2>
  <div class="share-row">
    <!-- The buttons need JavaScript; the script reveals each one the browser supports -->
    <button type="button" class="share-button" data-copy-link={url} hidden>
      <Icon name="lucide:link" aria-hidden="true" />
      <span>Copy link</span>
    </button>
    <button type="button" class="share-button" data-native-share={url} data-share-title={title} hidden>
      <Icon name="lucide:share-2" aria-hidden="true" />
      <span>Share</span>
    </button>
    {
      networks.map((network) => (
        <a
          class="share-button share-icon"
          href={network.href}
          target="_blank"
          rel="noopener noreferrer"
          data-copy-text={network.copyText}
          data-network={network.name}
        >
          <Icon name={network.icon} aria-hidden="true" />
          <span class="sr-only">Share on {network.name} (opens in a new tab)</span>
        </a>
      ))
    }
    <button type="button" class="share-button share-icon" data-mastodon-text={`${texts.mastodon}\n\n${url}`} aria-haspopup="dialog" hidden>
      <Icon name="simple-icons:mastodon" aria-hidden="true" />
      <span class="sr-only">Share on Mastodon</span>
    </button>
  </div>
  <p class="share-permalink">
    <span class="share-permalink-label">Permalink</span>
    <a href={url}>{displayUrl}</a>
  </p>
  <p class="share-status" role="status" aria-live="polite"></p>

  <dialog class="mastodon-dialog" aria-labelledby="mastodon-dialog-title">
    <form method="dialog" class="mastodon-form">
      <h2 id="mastodon-dialog-title" class="mastodon-title">Share on Mastodon</h2>
      <p class="mastodon-help">Mastodon is spread across many servers. Which one is your account on?</p>
      <label for="mastodon-server" class="mastodon-label">Your server</label>
      <input
        id="mastodon-server"
        name="server"
        type="text"
        inputmode="url"
        autocomplete="off"
        spellcheck="false"
        placeholder="mastodon.social"
        aria-describedby="mastodon-error"
        required
      />
      <p id="mastodon-error" class="mastodon-error"></p>
      <div class="mastodon-actions">
        <button type="submit" value="cancel" formnovalidate class="mastodon-cancel">Cancel</button>
        <button type="submit" value="share" class="mastodon-submit">Share</button>
      </div>
    </form>
  </dialog>
</section>

<script>
  const SERVER_KEY = 'mastodon-server';

  // Accepts "mastodon.social", "https://mastodon.social/" or a handle like "@keith@mastodon.social"
  function parseServer(input: string): string | undefined {
    const host = input
      .trim()
      .replace(/^@?[^@\s/]+@/, '')
      .replace(/^https?:\/\//i, '')
      .replace(/[/?#].*$/, '')
      .toLowerCase();
    return /^[a-z0-9-]+(\.[a-z0-9-]+)+$/.test(host) ? host : undefined;
  }

  function rememberedServer(): string {
    try {
      return localStorage.getItem(SERVER_KEY) ?? '';
    } catch {
      return '';
    }
  }

  function initShareButtons() {
    const status = document.querySelector<HTMLElement>('.share-status');
    const announce = (message: string) => {
      if (status) status.textContent = message;
    };

    document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((button) => {
      if (!navigator.clipboard || button.dataset.ready) return;
      button.dataset.ready = 'true';
      button.hidden = false;
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copyLink ?? location.href);
          announce('Link copied to clipboard.');
        } catch {
          announce('Could not copy the link. Use the permalink below instead.');
        }
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-native-share]').forEach((button) => {
      if (!navigator.share || button.dataset.ready) return;
      button.dataset.ready = 'true';
      button.hidden = false;
      button.addEventListener('click', () => {
        navigator.share({ title: button.dataset.shareTitle, url: button.dataset.nativeShare }).catch(() => {});
      });
    });

    // LinkedIn and Facebook can't prefill a post, so hand the suggested text over via the clipboard
    document.querySelectorAll<HTMLAnchorElement>('[data-copy-text]').forEach((link) => {
      if (!navigator.clipboard || link.dataset.ready) return;
      link.dataset.ready = 'true';
      link.addEventListener('click', () => {
        navigator.clipboard
          .writeText(link.dataset.copyText ?? '')
          .then(() => announce(`Suggested text copied. Paste it into your ${link.dataset.network} post.`))
          .catch(() => {});
      });
    });

    const mastodonButton = document.querySelector<HTMLButtonElement>('[data-mastodon-text]');
    const dialog = document.querySelector<HTMLDialogElement>('.mastodon-dialog');
    const form = dialog?.querySelector('form');
    const input = dialog?.querySelector<HTMLInputElement>('#mastodon-server');
    const error = dialog?.querySelector<HTMLElement>('#mastodon-error');
    if (mastodonButton && dialog && form && input && error && !mastodonButton.dataset.ready) {
      mastodonButton.dataset.ready = 'true';
      mastodonButton.hidden = false;
      mastodonButton.addEventListener('click', () => {
        input.value = rememberedServer();
        error.textContent = '';
        input.removeAttribute('aria-invalid');
        dialog.showModal();
      });
      form.addEventListener('submit', (event) => {
        if (event.submitter?.getAttribute('value') !== 'share') return;
        const server = parseServer(input.value);
        if (!server) {
          event.preventDefault();
          error.textContent = 'Enter a server name, such as mastodon.social.';
          input.setAttribute('aria-invalid', 'true');
          input.focus();
          return;
        }
        try {
          localStorage.setItem(SERVER_KEY, server);
        } catch {
          // Private browsing: just don't remember it
        }
        const text = encodeURIComponent(mastodonButton.dataset.mastodonText ?? '');
        window.open(`https://${server}/share?text=${text}`, '_blank', 'noopener');
      });
    }
  }

  document.addEventListener('astro:page-load', initShareButtons);
</script>

<style>
  .share {
    margin: 48px 0 32px;
    padding-top: 28px;
    border-top: 1px solid var(--blog-border);
  }

  .share-heading {
    margin: 0 0 14px;
    font-family: var(--font-reading);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blog-muted);
  }

  .share-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .share-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 44px;
    min-height: 44px;
    padding: 0 16px;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--blog-body);
    background: var(--blog-surface);
    border: 1px solid var(--blog-border);
    border-radius: 12px;
    cursor: pointer;
  }

  .share-button[hidden] {
    display: none;
  }

  .share-button:hover {
    color: var(--blog-text);
    border-color: #3b4453;
  }

  .share-icon {
    padding: 0;
  }

  .share-permalink {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin: 16px 0 0;
    font-size: 0.875rem;
    color: var(--blog-muted);
  }

  .share-permalink-label {
    font-weight: 700;
  }

  .share-permalink a {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--blog-secondary);
    word-break: break-all;
  }

  .share-status {
    min-height: 1.5em;
    margin: 8px 0 0;
    font-size: 0.875rem;
    color: var(--c-green);
  }

  .mastodon-dialog {
    width: min(420px, calc(100vw - 32px));
    padding: 0;
    color: var(--blog-text);
    background: var(--blog-surface);
    border: 1px solid var(--blog-border);
    border-radius: 20px;
  }

  .mastodon-dialog::backdrop {
    background: rgb(5 7 10 / 70%);
  }

  .mastodon-form {
    display: flex;
    flex-direction: column;
    padding: 24px;
  }

  .mastodon-title {
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--blog-text);
  }

  .mastodon-help {
    margin: 0 0 20px;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--blog-secondary);
  }

  .mastodon-label {
    margin-bottom: 6px;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--blog-body);
  }

  .mastodon-form input {
    min-height: 48px;
    padding: 0 14px;
    font: inherit;
    color: var(--blog-text);
    background: var(--blog-bg);
    border: 1px solid var(--blog-border);
    border-radius: 12px;
  }

  .mastodon-form input[aria-invalid='true'] {
    border-color: var(--c-red);
  }

  .mastodon-error {
    min-height: 1.4em;
    margin: 6px 0 12px;
    font-size: 0.875rem;
    color: var(--c-red);
  }

  .mastodon-actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }

  .mastodon-actions button {
    min-height: 44px;
    padding: 0 18px;
    font: inherit;
    font-weight: 700;
    border-radius: 999px;
    cursor: pointer;
  }

  .mastodon-cancel {
    color: var(--blog-body);
    background: transparent;
    border: 1px solid var(--blog-border);
  }

  .mastodon-submit {
    color: var(--blog-bg);
    background: var(--c-green);
    border: 1px solid var(--c-green);
  }
</style>
