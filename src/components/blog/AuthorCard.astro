---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import avatar from '../../assets/keith-avatar.png';
import { AUTHOR, SOCIAL_LINKS } from '../../lib/site';

const links = SOCIAL_LINKS.filter((link) => ['GitHub', 'LinkedIn', 'Fediverse'].includes(link.name));
---

<section class="author" aria-labelledby="author-heading">
  <Image src={avatar} alt="" width={144} height={144} class="author-photo" />
  <div class="author-text">
    <h2 id="author-heading" class="author-name"><a href={AUTHOR.profilePath} rel="author">{AUTHOR.name}</a></h2>
    <p class="author-role">{AUTHOR.jobTitle} @ {AUTHOR.employer.name}</p>
    <p class="author-bio">{AUTHOR.bio}</p>
    <ul class="author-links">
      {
        links.map((link) => (
          <li>
            <a href={link.url} rel="me noopener" target="_blank">
              <Icon name={link.icon} aria-hidden="true" />
              <span class="sr-only">{link.name} (opens in a new tab)</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .author {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    padding: 28px;
    background: var(--blog-surface);
    border: 1px solid var(--blog-border);
    border-radius: 20px;
  }

  .author-photo {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    border: 2px solid var(--c-green);
    object-fit: cover;
  }

  .author-name {
    margin: 0 0 2px;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .author-name a {
    color: var(--blog-text);
  }

  .author-name a:hover {
    text-decoration: underline;
  }

  .author-role {
    margin: 0 0 8px;
    font-size: 0.9375rem;
    color: var(--blog-secondary);
  }

  .author-bio {
    margin: 0 0 12px;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--blog-body);
  }

  .author-links {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .author-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--blog-secondary);
    border-radius: 10px;
  }

  .author-links a:hover {
    color: var(--blog-text);
    background: var(--blog-raised);
  }

  @media (max-width: 600px) {
    .author {
      flex-direction: column;
      padding: 20px;
    }
  }
</style>
