---
import { Icon } from 'astro-icon/components';

interface Props {
  name: string;
  level?: string;
  abbrev?: string;
  detail?: string;
  issuer: string;
  icon?: string;
}

const { name, level, abbrev, detail, issuer, icon } = Astro.props;

// Map our icon names to Simple Icons identifiers
const iconMap: Record<string, string> = {
  aws: 'simple-icons:amazonaws',
  linux: 'simple-icons:linux',
  java: 'simple-icons:oracle',
  php: 'simple-icons:php',
  cisco: 'simple-icons:cisco',
  microsoft: 'simple-icons:microsoft',
  oracle: 'simple-icons:oracle',
  suse: 'simple-icons:suse',
};

const iconName = icon && iconMap[icon] ? iconMap[icon] : null;
---

<div class="cert-badge">
  <div class="cert-icon">
    {iconName ? (
      <Icon name={iconName} />
    ) : (
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z" />
      </svg>
    )}
  </div>
  <div class="cert-info">
    <div class="cert-name">
      {name}
      {abbrev && <span class="cert-abbrev">({abbrev})</span>}
    </div>
    {(level || detail) && (
      <div class="cert-detail">
        {level && <span>{level}</span>}
        {level && detail && <span> - </span>}
        {detail && <span>{detail}</span>}
      </div>
    )}
    <div class="cert-issuer">{issuer}</div>
  </div>
</div>

<style>
  .cert-badge {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    padding: var(--space-md);
    background: var(--bg-secondary);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
  }

  .cert-badge:hover {
    border-color: var(--accent-green);
    transform: translateY(-2px);
  }

  .cert-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-card);
    border-radius: var(--radius-sm);
    color: var(--accent-green);
    flex-shrink: 0;
  }

  .cert-icon svg,
  .cert-icon [data-icon] {
    width: 24px;
    height: 24px;
  }

  .cert-info {
    flex: 1;
    min-width: 0;
  }

  .cert-name {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .cert-abbrev {
    color: var(--text-muted);
    font-weight: 400;
  }

  .cert-detail {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent-cyan);
    margin-top: 2px;
  }

  .cert-issuer {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: var(--space-xs);
  }
</style>
