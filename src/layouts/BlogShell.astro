---
import type { ComponentProps } from 'astro/types';
import BaseLayout from './BaseLayout.astro';
import NavRail from '../components/NavRail.astro';
import BottomNav from '../components/BottomNav.astro';
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/atkinson-hyperlegible-next/wght.css';
import '@fontsource-variable/atkinson-hyperlegible-next/wght-italic.css';
import '../styles/blog-palette.css';

// Page chrome for the blog and the about page: the "Field Notes" palette and type,
// the site navigation, a skip link and the footer.

type Props = ComponentProps<typeof BaseLayout> & {
  /** Highlighted navigation item. The about page passes none. */
  currentPage?: 'blog';
};

const { currentPage, ...layoutProps } = Astro.props;
const currentYear = new Date().getFullYear();
---

<BaseLayout {...layoutProps}>
  <slot name="head" slot="head" />
  <div class="blog-shell blog-palette">
    <a class="skip-link" href="#main">Skip to content</a>
    <NavRail currentPage={currentPage} />

    <main id="main" class="blog-main" transition:name="content" transition:animate="slide">
      <slot />

      <footer class="blog-footer">
        <span>&copy; 2003 - {currentYear} Keith Vassallo.</span>
        <nav aria-label="Footer" class="blog-footer-links">
          <a href="/blog/rss.xml">RSS</a>
          <a href="/about">About</a>
          <a href="https://github.com/keithvassallomt">GitHub</a>
          <a href="https://mt.linkedin.com/in/keithvassallo">LinkedIn</a>
        </nav>
      </footer>
    </main>

    <BottomNav currentPage={currentPage} />
  </div>
</BaseLayout>

<style>
  .blog-shell {
    /* The palette itself is in blog-palette.css. --bg-primary and --border-default are
       overridden so the shared navigation blends with the darker blog background. */
    --bg-primary: #0b0d12;
    --border-default: #262c37;

    min-height: 100vh;
    background: var(--blog-bg);
    color: var(--blog-text);
    font-family: var(--font-reading);
  }

  .skip-link {
    position: absolute;
    top: -100px;
    left: 96px;
    z-index: 200;
    padding: var(--space-sm) var(--space-md);
    font-weight: 700;
    color: var(--blog-bg);
    background: var(--c-green);
    border-radius: var(--radius-md);
  }

  .skip-link:focus {
    top: var(--space-md);
  }

  .blog-main {
    margin-left: 80px;
    padding: var(--space-2xl) 56px var(--space-3xl);
  }

  .blog-footer {
    max-width: 1180px;
    margin: 72px auto 0;
    padding-top: 28px;
    border-top: 1px solid var(--blog-border);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-md);
    font-size: 0.875rem;
    color: var(--blog-muted);
  }

  .blog-footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
  }

  .blog-footer-links a {
    color: var(--blog-secondary);
  }

  .blog-footer-links a:hover {
    color: var(--blog-text);
  }

  @media (max-width: 900px) {
    .skip-link {
      left: var(--space-md);
    }

    .blog-main {
      margin-left: 0;
      padding: var(--space-lg) 20px;
      padding-bottom: calc(60px + var(--space-xl) + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
