---
import BaseLayout from '../layouts/BaseLayout.astro';

const currentYear = new Date().getFullYear();
---

<BaseLayout title="Home">
  <main class="split-page">
    <!-- Left Panel - Dark -->
    <div class="panel panel-left" transition:name="sidebar" transition:animate="slide">
      <div class="panel-content">
        <header class="header">
          <span class="logo" transition:name="logo">
            <img src="/assets/icons/kv.png" alt="KV" class="logo-img" />
          </span>
        </header>

        <div class="intro">
          <p class="hello">Hello, world! I'm</p>
          <h1 class="name">Keith<br/><span class="surname">Vassallo</span></h1>
          <div class="typing-container">
            <span class="typing-text" id="typing-text"></span>
            <span class="cursor">|</span>
          </div>
        </div>

        <p class="description">
          I build things, break things, and teach others to do the same.
          Passionate about code, teaching, and open-source. Always with a laugh.
        </p>

        <a href="https://icecampus.com" target="_blank" class="job-badge">
          <img src="/assets/icons/icecampus.svg" alt="ICE Campus" class="job-logo" />
          <span class="job-title">Head of Technology @ ICE Campus</span>
        </a>

        <nav class="nav-buttons">
          <a href="/cv" class="nav-btn">
            <span class="nav-icon">01</span>
            <span class="nav-text">cv()</span>
            <span class="nav-arrow">&rarr;</span>
          </a>
          <a href="/projects" class="nav-btn">
            <span class="nav-icon">02</span>
            <span class="nav-text">projects()</span>
            <span class="nav-arrow">&rarr;</span>
          </a>
          <a href="/contact" class="nav-btn">
            <span class="nav-icon">03</span>
            <span class="nav-text">contact()</span>
            <span class="nav-arrow">&rarr;</span>
          </a>
        </nav>

        <div class="social-links">
