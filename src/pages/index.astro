          </a>
          <a href="https://mastodon.social/@keithvassallo86@threads.net" target="_blank" title="Fediverse">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M23.268 5.313c-.35-2.578-2.617-4.61-5.304-5.004C17.51.242 15.792 0 11.813 0h-.03c-3.98 0-4.835.242-5.288.309C3.882.692 1.496 2.518.917 5.127.64 6.412.61 7.837.661 9.143c.074 1.874.088 3.745.26 5.611.118 1.24.325 2.47.62 3.68.55 2.237 2.777 4.098 4.96 4.857 2.336.792 4.849.923 7.256.38.265-.061.527-.132.786-.213.585-.184 1.27-.39 1.774-.753a.057.057 0 0 0 .023-.043v-1.809a.052.052 0 0 0-.02-.041.053.053 0 0 0-.046-.01 20.282 20.282 0 0 1-4.709.545c-2.73 0-3.463-1.284-3.674-1.818a5.593 5.593 0 0 1-.319-1.433.053.053 0 0 1 .066-.054c1.517.363 3.072.546 4.632.546.376 0 .75 0 1.125-.01 1.57-.044 3.224-.124 4.768-.422.038-.008.077-.015.11-.024 2.435-.464 4.753-1.92 4.989-5.604.008-.145.03-1.52.03-1.67.002-.512.167-3.63-.024-5.545zm-3.748 9.195h-2.561V8.29c0-1.309-.55-1.976-1.67-1.976-1.23 0-1.846.79-1.846 2.35v3.403h-2.546V8.663c0-1.56-.617-2.35-1.848-2.35-1.112 0-1.668.668-1.668 1.977v6.218H4.822V8.102c0-1.31.337-2.35 1.011-3.12.696-.77 1.608-1.164 2.74-1.164 1.311 0 2.302.5 2.962 1.498l.638 1.06.638-1.06c.66-.999 1.65-1.498 2.96-1.498 1.13 0 2.043.395 2.74 1.164.675.77 1.012 1.81 1.012 3.12z"/></svg>
          </a>
          <a href="https://www.instagram.com/vassallo.keith/" target="_blank" title="Instagram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
        </div>

        <p class="copyright">&copy; 2003 - {currentYear} Keith Vassallo.</p>
      </div>
    </div>

    <!-- Right Panel - Accent -->
    <div class="panel panel-right">
      <div class="image-container">
        <img src="/assets/images/keith_pic.png" alt="Keith Vassallo" class="profile-image" />
      </div>
      <div class="accent-text">
        <span class="big-number">20+</span>
        <span class="label">Years of<br/>Experience</span>
      </div>
      <!-- Mobile scroll indicator -->
      <div class="scroll-indicator" id="scroll-indicator">
        <span class="scroll-text">Scroll</span>
        <div class="scroll-arrow">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 5v14M5 12l7 7 7-7"/>
          </svg>
        </div>
      </div>
    </div>
  </main>

  <script>
    // Typing animation
    const phrases = ["Geek", "Educator", "Developer", "Speaker", "Maker"];
    let phraseIndex = 0;
    let charIndex = 0;
    let isDeleting = false;
    const typingText = document.getElementById('typing-text');

    function type() {
      const currentPhrase = phrases[phraseIndex];
      if (isDeleting) {
        charIndex--;
        if (typingText) typingText.textContent = currentPhrase.substring(0, charIndex);
        if (charIndex === 0) {
          isDeleting = false;
          phraseIndex = (phraseIndex + 1) % phrases.length;
          setTimeout(type, 500);
        } else {
          setTimeout(type, 50);
        }
      } else {
        charIndex++;
        if (typingText) typingText.textContent = currentPhrase.substring(0, charIndex);
        if (charIndex === currentPhrase.length) {
          isDeleting = true;
          setTimeout(type, 2000);
        } else {
          setTimeout(type, 100);
        }
      }
    }
    type();

    // Scroll indicator - hide on scroll
    const scrollIndicator = document.getElementById('scroll-indicator');
    let hasScrolled = false;
    window.addEventListener('scroll', () => {
      if (!hasScrolled && window.scrollY > 50) {
        hasScrolled = true;
        scrollIndicator?.classList.add('hidden');
      }
    }, { passive: true });
  </script>
</BaseLayout>

<style>
  .split-page {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 100vh;
  }

  .panel {
    position: relative;
    overflow: hidden;
  }

  /* Left Panel */
  .panel-left {
    background: var(--bg-primary);
    padding: var(--space-2xl);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .panel-content {
    max-width: 500px;
    margin-left: auto;
  }

  .header {
    position: absolute;
    top: var(--space-xl);
    left: var(--space-xl);
  }

  .logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 2px solid var(--accent-green);
    border-radius: 50%;
    overflow: hidden;
  }

  .logo-img {
    width: 32px;
    height: 32px;
    object-fit: contain;
  }

  .intro {
    margin-bottom: var(--space-lg);
  }

  .hello {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--accent-green);
    margin-bottom: var(--space-sm);
  }

  .name {
    font-size: 4rem;
    font-weight: 700;
    line-height: 1;
    margin-bottom: var(--space-md);
  }

  .surname {
    background: linear-gradient(135deg, var(--text-primary) 0%, var(--accent-cyan) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .typing-container {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--text-secondary);
    min-height: 1.5rem;
  }

  .cursor {
    color: var(--accent-green);
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  .description {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-lg);
  }

  .job-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-xs) var(--space-md);
    background: var(--bg-secondary);
    border: 1px solid var(--border-default);
    border-radius: 100px;
    color: var(--text-secondary);
    text-decoration: none;
    margin-bottom: var(--space-xl);
    transition: all var(--transition-fast);
  }

  .job-badge:hover {
    border-color: var(--accent-cyan);
    color: var(--text-primary);
  }

  .job-logo {
    height: 18px;
    width: auto;
    filter: invert(1) brightness(2);
  }

  .job-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .nav-buttons {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .nav-btn {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md) var(--space-lg);
    background: transparent;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--text-primary);
    text-decoration: none;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .nav-btn:hover {
    background: var(--bg-secondary);
    border-color: var(--accent-green);
    transform: translateX(4px);
  }

  .nav-icon {
    color: var(--accent-green);
    font-size: 0.75rem;
  }

  .nav-text {
    flex: 1;
    text-align: left;
  }

  .nav-arrow {
    color: var(--text-muted);
    transition: transform var(--transition-fast);
  }

  .nav-btn:hover .nav-arrow {
    transform: translateX(4px);
    color: var(--accent-green);
  }

  .social-links {
    display: flex;
    gap: var(--space-lg);
  }

  .social-links a {
    color: var(--text-muted);
    transition: color var(--transition-fast);
  }

  .social-links a:hover {
    color: var(--accent-cyan);
  }

  .copyright {
    margin-top: var(--space-lg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /* Right Panel */
  .panel-right {
    background: linear-gradient(135deg, #1a3a35 0%, #0d1f1c 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--space-2xl);
    position: relative;
  }

  .image-container {
    position: relative;
    max-width: 350px;
  }

  .profile-image {
    width: 100%;
    border-radius: var(--radius-xl);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }

  /* Scroll indicator - hidden by default on desktop */
  .scroll-indicator {
    display: none;
    position: absolute;
    bottom: var(--space-lg);
    left: 50%;
    transform: translateX(-50%);
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    color: rgba(255, 255, 255, 0.7);
    transition: opacity 0.3s ease;
  }

  .scroll-indicator.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .scroll-text {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .scroll-arrow {
    animation: bounce 2s ease-in-out infinite;
  }

  @keyframes bounce {
    0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
    40% { transform: translateY(8px); }
    60% { transform: translateY(4px); }
  }

  .accent-text {
    position: absolute;
    bottom: var(--space-2xl);
    right: var(--space-2xl);
    text-align: right;
  }

  .big-number {
    display: block;
    font-family: var(--font-mono);
    font-size: 4rem;
    font-weight: 700;
    color: var(--accent-green);
    line-height: 1;
  }

  .label {
    font-size: 0.875rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  /* Modal */
  .modal { background: transparent; border: none; padding: 0; max-width: 90vw; width: 450px; }
  .modal::backdrop { background: rgba(0,0,0,0.85); backdrop-filter: blur(4px); }
  .modal-content { background: var(--bg-card); border: 1px solid var(--border-default); border-radius: var(--radius-xl); padding: var(--space-xl); position: relative; }
  .modal-close { position: absolute; top: var(--space-md); right: var(--space-md); background: none; border: none; color: var(--text-secondary); font-size: 1.5rem; cursor: pointer; }
  .modal h2 { margin-bottom: var(--space-lg); }
  .contact-form { display: flex; flex-direction: column; gap: var(--space-md); }
  .form-group { display: flex; flex-direction: column; gap: var(--space-xs); }
  .form-group label { font-family: var(--font-mono); font-size: 0.875rem; color: var(--text-secondary); }
  .form-group input, .form-group textarea { background: var(--bg-secondary); border: 1px solid var(--border-default); border-radius: var(--radius-md); padding: var(--space-sm) var(--space-md); color: var(--text-primary); font-family: inherit; font-size: 1rem; }
  .form-group input:focus, .form-group textarea:focus { outline: none; border-color: var(--accent-cyan); }
  .btn-full { width: 100%; justify-content: center; }
  .form-status { font-family: var(--font-mono); font-size: 0.875rem; padding: var(--space-sm); text-align: center; }
  .form-status.success { color: var(--accent-green); }
  .form-status.error { color: var(--accent-red); }
  .form-status:empty { display: none; }

  /* Responsive */
  @media (max-width: 900px) {
    .split-page {
      grid-template-columns: 1fr;
    }
    .panel-left {
      order: 2;
      padding: var(--space-xl);
      padding-top: var(--space-md);
    }
    .panel-content {
      margin: 0 auto;
      text-align: center;
    }
    .panel-right {
      order: 1;
      min-height: calc(100vh - 220px);
      min-height: calc(100svh - 220px);
    }
    .header {
      position: relative;
      top: 0;
      left: 0;
      margin-bottom: var(--space-lg);
    }
    .name { font-size: 3rem; }
    .typing-container { text-align: center; }
    .nav-buttons { max-width: 400px; margin: 0 auto var(--space-xl); }
    .social-links { justify-content: center; }
    .image-container { max-width: 250px; }
    .accent-text { display: none; }
    .scroll-indicator { display: flex; }
  }

  @media (max-width: 480px) {
    .name { font-size: 2.5rem; }
    .panel-right {
      min-height: calc(100vh - 200px);
      min-height: calc(100svh - 200px);
    }
  }
</style>
