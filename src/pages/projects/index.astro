---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavRail from '../../components/NavRail.astro';
import BottomNav from '../../components/BottomNav.astro';
import ProjectTile from '../../components/ProjectTile.astro';
import yaml from 'js-yaml';
import fs from 'node:fs';
import path from 'node:path';

// Load projects data
const projectsPath = path.join(process.cwd(), 'src/data/projects/projects.yaml');
const projectsData = yaml.load(fs.readFileSync(projectsPath, 'utf8')) as any;
const projects = projectsData.projects;
---

<BaseLayout title="Projects">
  <div class="app-layout">
    <NavRail currentPage="projects" />

    <main class="content-area" transition:name="content" transition:animate="slide">
      <div class="page-header">
        <h1>Projects</h1>
        <p class="page-subtitle">Things I've built and contributed to</p>
      </div>

      <div class="floating-container" id="floating-container">
        <!-- Backdrop for expanded cards (must be before cards for z-index) -->
        <div class="card-backdrop" id="card-backdrop"></div>

        <div class="floating-cards" id="floating-cards">
          {projects.map((project: any, index: number) => (
            <ProjectTile
              id={project.id}
              title={project.title}
              shortDescription={project.shortDescription}
              description={project.description}
              logo={project.logo}
              media={project.media}
              technologies={project.technologies}
              link={project.link}
              repo={project.repo}
              index={index}
            />
          ))}
        </div>
      </div>
    </main>

    <BottomNav currentPage="projects" />
  </div>
</BaseLayout>

<script>
  function initFloatingCards() {
    const cardsWrapper = document.getElementById('floating-cards');
    const backdrop = document.getElementById('card-backdrop');
    if (!cardsWrapper || !backdrop) return;

    const cards = cardsWrapper.querySelectorAll('.floating-card');

    // Card expand/collapse
    cards.forEach(card => {
      const cardFace = card.querySelector('.card-face');
      const closeBtn = card.querySelector('.close-btn');

      cardFace?.addEventListener('click', () => {
        expandCard(card);
      });

      closeBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        collapseCard(card);
      });

      // Initialize carousel
      initCarousel(card);
    });

    // Global 3D tilt effect - all cards face the cursor
    const maxTilt = 15; // Maximum tilt in degrees

    function updateCardTilts(mouseX: number, mouseY: number) {
      cards.forEach(card => {
        if (card.classList.contains('expanded')) return;

        const cardEl = card as HTMLElement;
        const rect = cardEl.getBoundingClientRect();
        const cardCenterX = rect.left + rect.width / 2;
        const cardCenterY = rect.top + rect.height / 2;

        // Calculate direction from card center to mouse
        const deltaX = mouseX - cardCenterX;
        const deltaY = mouseY - cardCenterY;

        // Normalize based on viewport size for consistent effect
        const normalizedX = deltaX / window.innerWidth;
        const normalizedY = deltaY / window.innerHeight;

        // Calculate tilt (card tilts toward cursor)
        const rotateY = normalizedX * maxTilt * 2;
        const rotateX = -normalizedY * maxTilt * 2;

        cardEl.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
      });
    }

    // Track mouse movement anywhere on the page
    document.addEventListener('mousemove', (e) => {
      updateCardTilts(e.clientX, e.clientY);
    });

    function expandCard(card: Element) {
      // Collapse any other expanded cards
      cards.forEach(c => {
        if (c !== card && c.classList.contains('expanded')) {
          collapseCard(c);
        }
      });

      card.classList.add('expanded');
      backdrop.classList.add('visible');
      document.body.style.overflow = 'hidden';
    }

    function collapseCard(card: Element) {
      card.classList.remove('expanded');

      // Reset transform
      (card as HTMLElement).style.transform = '';

      // Pause videos
      card.querySelectorAll('video').forEach(v => v.pause());

      // Hide backdrop if no cards expanded
      const anyExpanded = Array.from(cards).some(c => c.classList.contains('expanded'));
      if (!anyExpanded) {
        backdrop.classList.remove('visible');
        document.body.style.overflow = '';
      }
    }

    // Close on backdrop click
    backdrop.addEventListener('click', () => {
      cards.forEach(card => {
        if (card.classList.contains('expanded')) {
          collapseCard(card);
        }
      });
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        cards.forEach(card => {
          if (card.classList.contains('expanded')) {
            collapseCard(card);
          }
        });
      }
    });

    function initCarousel(card: Element) {
      const carousel = card.querySelector('[data-carousel]');
      if (!carousel) return;

      const track = carousel.querySelector('.carousel-track') as HTMLElement;
      const slides = carousel.querySelectorAll('.carousel-slide');
      const dots = carousel.querySelectorAll('.carousel-dot');
      const prevBtn = carousel.querySelector('.carousel-btn.prev');
      const nextBtn = carousel.querySelector('.carousel-btn.next');

      if (!track || slides.length <= 1) return;

      let currentIndex = 0;

      function goToSlide(index: number) {
        slides.forEach(slide => {
          const video = slide.querySelector('video');
          if (video) video.pause();
        });

        currentIndex = Math.max(0, Math.min(index, slides.length - 1));
        track.style.transform = `translateX(-${currentIndex * 100}%)`;

        dots.forEach((dot, i) => {
          dot.classList.toggle('active', i === currentIndex);
        });
      }

      prevBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        goToSlide(currentIndex - 1);
      });

      nextBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        goToSlide(currentIndex + 1);
      });

      dots.forEach((dot, i) => {
        dot.addEventListener('click', (e) => {
          e.stopPropagation();
          goToSlide(i);
        });
      });
    }
  }

  // Initialize
  initFloatingCards();
  document.addEventListener('astro:page-load', initFloatingCards);
</script>

<style>
  .app-layout {
    display: flex;
    min-height: 100vh;
  }

  .content-area {
    flex: 1;
    margin-left: 80px;
    padding: var(--space-2xl);
    background: var(--bg-primary);
    overflow-x: hidden;
  }

  .page-header {
    margin-bottom: var(--space-xl);
  }

  .page-header h1 {
    font-family: var(--font-mono);
    font-size: 2.5rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: var(--space-sm);
  }

  .page-subtitle {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--text-muted);
  }

  /* Floating Container */
  .floating-container {
    position: relative;
    min-height: 80vh;
    perspective: 1000px;
  }

  .floating-cards {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xl);
    justify-content: center;
    align-items: flex-start;
    padding: var(--space-xl) 0;
  }

  /* Backdrop */
  .card-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(13, 17, 23, 0.7);
    backdrop-filter: blur(4px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    z-index: 500;
  }

  .card-backdrop.visible {
    opacity: 1;
    visibility: visible;
  }

  /* Mobile responsive */
  @media (max-width: 900px) {
    .content-area {
      margin-left: 0;
      padding: var(--space-lg);
      padding-bottom: calc(60px + var(--space-lg) + env(safe-area-inset-bottom, 0px));
    }

    .page-header h1 {
      font-size: 2rem;
    }

    .floating-cards {
      gap: var(--space-lg);
    }
  }

  @media (max-width: 600px) {
    .floating-cards {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
