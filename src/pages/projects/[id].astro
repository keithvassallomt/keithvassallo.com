---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectsGallery from '../../components/ProjectsGallery.astro';
import { loadProjects } from '../../lib/projects';
import { absoluteUrl } from '../../lib/site';
import { siteCardAsset, SOCIAL_IMAGE_HEIGHT, SOCIAL_IMAGE_WIDTH } from '../../lib/social';

export function getStaticPaths() {
  return loadProjects().map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
// Per-project images come from scripts/generate-og-images.sh (1200x630 JPEG)
const ogImage = project.bgImage || project.logo
  ? {
      url: absoluteUrl(`/assets/og/${project.id}.jpg`),
      width: SOCIAL_IMAGE_WIDTH,
      height: SOCIAL_IMAGE_HEIGHT,
      type: 'image/jpeg' as const,
      alt: `${project.title}: ${project.shortDescription}`,
    }
  : siteCardAsset('projects').image;
---

<BaseLayout title={project.title} description={project.shortDescription} image={ogImage}>
  <ProjectsGallery expandId={project.id} />
</BaseLayout>
